# HomeFinance — exemplo de configuração
#
# Copie para backend/.env (que está no .gitignore) e preencha. NUNCA commite
# segredos reais. A aplicação NÃO lê este arquivo: ela lê apenas o ambiente do
# processo (docs/SEGURANCA.md §7). Em desenvolvimento, quem traduz arquivo ->
# ambiente é backend/scripts/dev.ps1 (ou dev.sh), que também sobe a API.
#
# Toda chave abaixo que está comentada usa o padrão do código. Descomente só o
# que você realmente for mudar.

# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------
APP_ENV=development              # development | test | production

# ---------------------------------------------------------------------------
# Servidor HTTP
# ---------------------------------------------------------------------------
# 8080 é o padrão do código E o alvo do proxy do Vite (frontend/vite.config.ts).
# Se mudar aqui, aponte o proxy com VITE_API_PROXY_TARGET ou o frontend quebra
# com ECONNREFUSED.
HTTP_ADDR=:8080

# Origens do frontend, separadas por vírgula. Absolutas, sem curinga.
# Obrigatório em produção.
CORS_ORIGIN=http://localhost:5173

# Quantos proxies confiáveis existem à frente. Com 0, X-Forwarded-For é
# ignorado — necessário para o rate limit por IP não ser burlável.
#TRUSTED_PROXY_COUNT=0

# ---------------------------------------------------------------------------
# Log
# ---------------------------------------------------------------------------
#LOG_LEVEL=info                  # debug | info | warn | error
LOG_FORMAT=text                  # json em produção; text é legível em dev

# ---------------------------------------------------------------------------
# Banco de dados — qualquer SQL (ADR-008: GORM + AutoMigrate)
# ---------------------------------------------------------------------------
DB_DRIVER=sqlite                 # sqlite | postgres | mysql | sqlserver
DB_DSN=homefinance.db            # DSN no formato do driver escolhido
# Exemplos:
#   postgres:  postgres://user:pass@localhost:5432/homefinance?sslmode=disable
#   mysql:     user:pass@tcp(localhost:3306)/homefinance?parseTime=true
#   sqlserver: sqlserver://user:pass@localhost:1433?database=homefinance
# sqlite é REJEITADO em produção.

#DB_AUTOMIGRATE=true
#DB_MAX_OPEN_CONNS=25
#DB_MAX_IDLE_CONNS=5
#DB_CONN_MAX_LIFETIME=30m

# ---------------------------------------------------------------------------
# Segredos — OBRIGATÓRIOS, sem valor padrão
# ---------------------------------------------------------------------------
# Mínimo de 32 bytes CADA, em qualquer ambiente, e precisam ser DIFERENTES
# entre si. Deixados em branco de propósito: o boot falha com mensagem clara
# em vez de rodar com um segredo de exemplo.
#
# Gere cada um com:
#   PowerShell: $rng = [System.Security.Cryptography.RNGCryptoServiceProvider]::new()
#               $b = [byte[]]::new(48); $rng.GetBytes($b); [Convert]::ToBase64String($b)
#   bash:       openssl rand -base64 48
JWT_SECRET=
OTP_PEPPER=

# ---------------------------------------------------------------------------
# Sessão e JWT
# ---------------------------------------------------------------------------
#JWT_ISSUER=homefinance
#JWT_AUDIENCE=homefinance-api
ACCESS_TOKEN_TTL=15m             # limitado a 1m–15m
REFRESH_TOKEN_TTL=336h           # 14 dias; precisa ser maior que o access

# ---------------------------------------------------------------------------
# Código de 6 dígitos (OTP) — ADR-009
# ---------------------------------------------------------------------------
#OTP_TTL=15m                     # limitado a 5m–15m
#OTP_MAX_ATTEMPTS=5              # limitado a 1–5
#OTP_RESEND_INTERVAL=60s         # mínimo de 30s

# ---------------------------------------------------------------------------
# Hash de senha (Argon2id) — os padrões são os mínimos permitidos
# ---------------------------------------------------------------------------
#ARGON2_MEMORY_KIB=65536         # 64 MiB, mínimo
#ARGON2_ITERATIONS=3
#ARGON2_PARALLELISM=2
#ARGON2_MAX_CONCURRENT=4         # cada hash reserva 64 MiB

# ---------------------------------------------------------------------------
# Endpoints sensíveis
# ---------------------------------------------------------------------------
# Piso de tempo de resposta que impede a latência de revelar se a conta existe.
#AUTH_MIN_RESPONSE_TIME=300ms

# ---------------------------------------------------------------------------
# Cookies de sessão — ADR-013
# ---------------------------------------------------------------------------
COOKIE_SECURE=false              # OBRIGATÓRIO true em produção (prefixo __Host-)

# Precisa ficar VAZIO quando COOKIE_SECURE=true: o prefixo __Host- proíbe o
# atributo Domain.
COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# E-mail
# ---------------------------------------------------------------------------
# console imprime o e-mail inteiro (com o código de 6 dígitos) no STDOUT.
# Só desenvolvimento — em produção o boot exige smtp.
MAILER=console
MAIL_FROM=nao-responda@homefinance.local
#MAIL_FROM_NAME=HomeFinance
#MAIL_QUEUE_SIZE=256

# Obrigatórios com MAILER=smtp:
#SMTP_HOST=
#SMTP_PORT=587                   # 465 = TLS implícito; demais = STARTTLS
#SMTP_USERNAME=
#SMTP_PASSWORD=
#SMTP_TLS=true                   # não pode ser false em produção
