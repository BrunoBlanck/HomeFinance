# Extratos e faturas reais usados como amostra de formato.
# Contêm nome, agência, conta, CNPJ e valores reais — NUNCA versionar.
# Fixture de teste é cópia ANONIMIZADA, em internal/importer/*/testdata/.
Exemplos/

# Segredos e configuração local — NUNCA versionar
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Go
backend/bin/
backend/tmp/
*.exe
*.test
*.out
coverage.out

# Node / React
frontend/node_modules/
frontend/dist/
frontend/coverage/
*.log

# Playwright (artefatos de execucao; a configuracao e os testes sao versionados)
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/.playwright/

# Bancos locais
*.db
*.sqlite
*.sqlite3

# IDE / SO
.idea/
.vscode/
*.swp
Thumbs.db
.DS_Store

# Claude Code (configuração local do usuário)
.claude/settings.local.json
